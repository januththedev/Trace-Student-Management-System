# PostgreSQL (Neon in production; local docker in dev). Required.
DATABASE_URL=postgres://t2t:t2t_dev_password@127.0.0.1:55432/t2t
# Separate database used by integration tests (it is wiped). Required for `pnpm test:int`.
TEST_DATABASE_URL=postgres://t2t:t2t_dev_password@127.0.0.1:55432/t2t_test
# 32-byte base64 key for AES-256-GCM NIC encryption at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NIC_ENCRYPTION_KEY=
# 32-byte base64 key for HMAC NIC lookup digests (exact match/uniqueness). Different from the encryption key.
NIC_LOOKUP_KEY=
# 32-byte base64 key for session/device token HMACs and CSRF.
SESSION_SECRET=
# Shared secret the scheduler (Vercel Cron) sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Storage adapter: "local" (DEVELOPMENT ONLY, private directory outside /public; throws in production unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true) or "s3" (S3-compatible private bucket, src/server/storage/s3.ts).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.private-storage
# S3 driver requires S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY. Optional:
# S3_ENDPOINT (HTTP(S) URL; HTTPS enforced in production; e.g. MinIO/R2), S3_FORCE_PATH_STYLE=true|false
# (defaults true when S3_ENDPOINT is set), S3_SESSION_TOKEN (temporary credentials).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Malware scanner adapter: "none" (status shown to operators as NOT_CONFIGURED) or "clamav"
# (clamd INSTREAM over trusted private TCP; a configured scanner that fails is fail-closed, never "clean").
# Only a local protocol harness is verified — verify a real daemon before production use.
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
# clamd port (default 3310), absolute scan deadline in ms (default 10000, range 50-60000) and
# max scannable bytes (default falls back to RECEIPT_MAX_BYTES, else 10 MiB; range 1-100 MiB).
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
# Leave this unset to follow RECEIPT_MAX_BYTES; set an explicit limit if needed.
# CLAMAV_MAX_BYTES=10485760
# Max receipt upload size in bytes (default 10 MiB).
RECEIPT_MAX_BYTES=10485760
# Student session lifetimes (minutes).
STUDENT_IDLE_MINUTES=30
STUDENT_ABSOLUTE_MINUTES=720
# Optional outbound channels. Disabled unless explicitly configured and enabled.
EMAIL_ENABLED=false
SMS_ENABLED=false
# Public base URL (used for invitation links).
APP_BASE_URL=http://localhost:3000
