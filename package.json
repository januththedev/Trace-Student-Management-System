{
  "name": "t2t-student-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prepare-pdfjs.mjs",
    "dev": "next dev",
    "build": "node scripts/prepare-pdfjs.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "bootstrap:super-admin": "node --conditions=react-server --import tsx scripts/bootstrap-super-admin.ts",
    "reconcile": "node --conditions=react-server --import tsx scripts/reconcile.ts",
    "test": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@date-fns/tz": "^1.5.0",
    "@pdf-lib/fontkit": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "regenerator-runtime": "0.14.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.5.1"
}
